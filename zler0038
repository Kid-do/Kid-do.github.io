FORM GET_IT01 USING PS_HEAD LIKE GS_HEAD.
 
  CLEAR GT_IT01[].
 
  DATA: LV_QTY(16),
        LV_NET_WEIGHT(16).
 
  "lips-posnr 별 bundle 리스트
*  IF ps_head-wbstk = 'C'.
*    SELECT b~werks,
*           a~matnr,
*           a~zz_pon_lot,
*           a~zz_lgpla,
*           a~zz_bundle,
*           a~zz_heat,
*           a~zz_gr_dats,
*           b~charg,
*           b~lgort,
*           b~lfimg AS kalab
*      FROM zppt9000 AS a  INNER JOIN lips AS b
*                                  ON b~matnr EQ a~matnr
*                                 AND b~charg EQ a~charg
*     WHERE b~vbeln      EQ @ps_head-vbeln
*       AND a~zz_werks   EQ @ps_head-werks
*       AND a~matnr      EQ @ps_head-matnr
*       AND a~zz_pon_lot EQ @ps_head-zz_pon_lot
*       AND b~lfimg      <> 0
*      INTO TABLE @DATA(lt_mska).
*
*  ENDIF.
 
  "mska-재고정보 별 bundle 리스트
*  IF ps_head-wbstk <> 'C'.
 
  SELECT B~WERKS,
         A~MATNR,
         A~ZZ_PON_LOT,
         A~ZZ_LGPLA,
         A~ZZ_BUNDLE,
         A~ZZ_HEAT,
         A~ZZ_GR_DATS,
         A~ZZ_LINE_TY,
         A~ZZ_STYPE,
         C~CDNM AS STYPE_NM,
         A~ZZ_SERIAL,
         A~ZZ_QTY,
         A~ZZ_NET_WEIGHT,
         B~CHARG,
         B~LGORT,
         B~KALAB,
         B~VBELN,
         B~POSNR
    FROM ZPPT9000 AS A INNER JOIN MSKA AS B
                               ON A~MATNR    EQ B~MATNR
                              AND A~CHARG    EQ B~CHARG
                              AND A~ZZ_WERKS EQ B~WERKS
                  LEFT OUTER JOIN ZCAT0102 AS C
                               ON A~ZZ_STYPE EQ C~CD
                              AND C~CD_CLF EQ 'WM1006'
   WHERE B~KALAB       > 0
     AND A~ZZ_WERKS   EQ @PS_HEAD-WERKS
     AND A~MATNR      EQ @PS_HEAD-MATNR
     AND A~ZZ_PON_LOT EQ @PS_HEAD-ZZ_PON_LOT
    INTO TABLE @DATA(LT_MSKA).
 
  IF LT_MSKA[] IS INITIAL.
    SELECT B~WERKS,
           A~MATNR,
           A~ZZ_PON_LOT,
           A~ZZ_LGPLA,
           A~ZZ_BUNDLE,
           A~ZZ_HEAT,
           A~ZZ_GR_DATS,
           A~ZZ_LINE_TY,
           A~ZZ_STYPE,
           C~CDNM AS STYPE_NM,
           A~ZZ_SERIAL,
           A~ZZ_QTY,
           A~ZZ_NET_WEIGHT,
           B~CHARG,
           B~LGORT,
           B~CLABS AS KALAB,
           A~ZZ_VBELN AS VBELN,
           A~ZZ_POSNR AS POSNR
      FROM ZPPT9000 AS A INNER JOIN MCHB AS B
                                 ON A~MATNR    EQ B~MATNR
                                AND A~CHARG    EQ B~CHARG
                                AND A~ZZ_WERKS EQ B~WERKS
                    LEFT OUTER JOIN ZCAT0102 AS C
                                 ON A~ZZ_STYPE EQ C~CD
                                AND C~CD_CLF EQ 'WM1006'
     WHERE B~CLABS       > 0
