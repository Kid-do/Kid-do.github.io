DEFINE gfw_write.
  if cl_gfw=>msg_protocol_active      = gfw_true  or
     cl_gfw=>msg_protocol_initialized = gfw_false.
    call method cl_gfw=>write_msg_protocol exporting msgno = &1
                                           methname = &2 msgtype = &3.
  endif.
END-OF-DEFINITION.
