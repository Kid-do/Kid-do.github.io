*&---------------------------------------------------------------------*
*& Form submit_zsdr4000
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*&      --> GS_HEAD_ORG_VBELN
*&---------------------------------------------------------------------*
FORM SUBMIT_ZSDR4000 USING PV_VBELN TYPE LIKP-VBELN.
 
 
  "입력받은 출하지시 번호로 하위 분할 do 선택
 
  DATA : LR_ERDAT TYPE RANGE OF SY-DATLO,
         LR_DAT   TYPE RANGE OF SY-DATLO,
         LR_VKORG TYPE RANGE OF VBAK-VKORG,
         LR_VTWEG TYPE RANGE OF VBAK-VTWEG,
         LR_SPART TYPE RANGE OF VBAK-SPART,
         LR_WERKS TYPE RANGE OF VBAP-WERKS,
         LR_VKBUR TYPE RANGE OF VBAK-VKBUR,
         LR_KUNNR TYPE RANGE OF LIKP-KUNNR,
         LR_BSTKD TYPE RANGE OF VBKD-BSTKD,
         LR_VGBEL TYPE RANGE OF LIPS-VGBEL, "공백값
 
         LR_VBELN TYPE RANGE OF LIKP-VBELN WITH HEADER LINE, "공백값
         LV_EXIST TYPE CHAR1.
 
  "선택한 출하지시의 영업조직을 읽는다.
  SELECT SINGLE VKORG INTO @DATA(LV_VKORG)
         FROM LIKP
         WHERE VBELN = @PV_VBELN.
 
  "원출하지시로 ledspd_flow 값을 모두 선택
  SELECT A~VBELN,
         A~VBELN_NEW
         FROM LEDSPD_FLOW AS A INNER JOIN LIKP AS B
               ON A~VBELN = B~VBELN
         WHERE A~VBELN = @PV_VBELN
           AND A~UPDKZ = @ZCA_I
         INTO TABLE @DATA(LT_FLOW).
 
  SELECT VBELN,
         VBELN_NEW
         FROM LEDSPD_FLOW
         WHERE VBELN_NEW = @PV_VBELN
           AND UPDKZ = @ZCA_I
         APPENDING TABLE @LT_FLOW.
 
  SORT LT_FLOW BY VBELN VBELN_NEW.
  DELETE ADJACENT DUPLICATES FROM LT_FLOW COMPARING VBELN VBELN_NEW.
 
  IF LINES( LT_FLOW ) > 0.
    LOOP AT LT_FLOW INTO DATA(LS_FLOW).
      LR_VBELN-SIGN = ZCA_I.
      LR_VBELN-OPTION = ZCA_EQ.
      LR_VBELN-LOW = LS_FLOW-VBELN.
      COLLECT LR_VBELN.
      LR_VBELN-SIGN = ZCA_I.
      LR_VBELN-OPTION = ZCA_EQ.
      LR_VBELN-LOW = LS_FLOW-VBELN_NEW.
      COLLECT LR_VBELN.
    ENDLOOP.
 
    DO.
      CLEAR LV_EXIST.
      CLEAR LT_FLOW[].
      SELECT A~VBELN,
             A~VBELN_NEW
             FROM LEDSPD_FLOW  AS A INNER JOIN LIKP AS B
                 ON A~VBELN = B~VBELN
             WHERE A~VBELN IN @LR_VBELN
               AND A~UPDKZ = @ZCA_I
             INTO TABLE @LT_FLOW.
 
      SELECT A~VBELN,
             A~VBELN_NEW
             FROM LEDSPD_FLOW  AS A INNER JOIN LIKP AS B
                 ON A~VBELN_NEW = B~VBELN
             WHERE A~VBELN_NEW IN @LR_VBELN
               AND A~UPDKZ = @ZCA_I
             APPENDING TABLE @LT_FLOW.
 
      SORT LT_FLOW BY VBELN VBELN_NEW.
      DELETE ADJACENT DUPLICATES FROM LT_FLOW COMPARING VBELN VBELN_NEW.
 
      LOOP AT LT_FLOW INTO LS_FLOW.
        READ TABLE LR_VBELN WITH KEY LOW = LS_FLOW-VBELN.
        IF SY-SUBRC = 0.
          CLEAR LS_FLOW-VBELN.
        ELSE.
          LR_VBELN-SIGN = ZCA_I.
          LR_VBELN-OPTION = ZCA_EQ.
          LR_VBELN-LOW = LS_FLOW-VBELN.
          COLLECT LR_VBELN.
          LV_EXIST = ABAP_TRUE.
        ENDIF.
        READ TABLE LR_VBELN WITH KEY LOW = LS_FLOW-VBELN_NEW.
        IF SY-SUBRC = 0.
          CLEAR LS_FLOW-VBELN_NEW.
        ELSE.
          LR_VBELN-SIGN = ZCA_I.
          LR_VBELN-OPTION = ZCA_EQ.
          LR_VBELN-LOW = LS_FLOW-VBELN_NEW.
          COLLECT LR_VBELN.
          LV_EXIST = ABAP_TRUE.
        ENDIF.
        IF LS_FLOW-VBELN IS INITIAL AND LS_FLOW-VBELN_NEW IS INITIAL.
          DELETE LT_FLOW.
        ENDIF.
      ENDLOOP.
      IF LV_EXIST = SPACE.
        EXIT.
      ENDIF.
 
    ENDDO.
  ELSE.
    LR_VBELN[] = VALUE #( ( SIGN = ZCA_I OPTION = ZCA_EQ
                          LOW = PV_VBELN ) ).
  ENDIF.
 
 
  LR_VKORG[] = VALUE #( ( SIGN = ZCA_I OPTION = ZCA_EQ
                          LOW = LV_VKORG ) ).
 
  LR_VTWEG[] = VALUE #( ( SIGN = ZCA_I OPTION = ZCA_CP
                          LOW = '*' ) ).
 
  LR_SPART[] = VALUE #( ( SIGN = ZCA_I OPTION = ZCA_CP
                          LOW = '*' ) ).
  "일자를 넣어주어야 하기에 아래의 값 setting.
  LR_ERDAT = VALUE #( ( SIGN = ZCA_I OPTION = ZCA_BT LOW = '20240101' HIGH = SY-DATLO ) ).
 
  SUBMIT ZSDR4000 WITH P_con1    = ABAP_TRUE
                  WITH P_con2    = ABAP_TRUE
                  WITH P_con3    = ABAP_TRUE
                  WITH P_iss1    = ABAP_TRUE
                  WITH P_iss2    = ABAP_TRUE
                  WITH S_ERDAT  IN LR_ERDAT "2024.07.01 ~ 현재일0
                  WITH S_WADAT  IN LR_DAT   "공백값
                  WITH S_WAIST  IN LR_DAT   "공백값
 
                  WITH S_VKORG  IN LR_VKORG
                  WITH S_VTWEG  IN LR_VTWEG
                  WITH S_SPART  IN LR_SPART
                  WITH S_WERKS  IN LR_WERKS "공백값
                  WITH S_VKBUR  IN LR_VKBUR "공백값
                  WITH S_KUNZA  IN LR_KUNNR "공백값
 
                  WITH S_KUNAG  IN LR_KUNNR "공백값
                  WITH S_KUNNR  IN LR_KUNNR "공백값
                  WITH S_KUNZB  IN LR_KUNNR "공백값
                  WITH S_BSTKD  IN LR_BSTKD "공백값
                  WITH S_VGBEL  IN LR_VGBEL "공백값
 
                  WITH S_VBELN  IN LR_VBELN "공백값
                  WITH P_ITEM    = SPACE
                  WITH P_0EX     = SPACE
                  WITH P_RFC     = SPACE
                  WITH P_G1      = ABAP_TRUE
                  WITH P_G2      = ABAP_TRUE
                  WITH P_G3      = ABAP_TRUE
                  WITH P_G4      = ABAP_TRUE
                  WITH P_G5      = ABAP_TRUE
                  WITH P_G6      = ABAP_TRUE
                  WITH P_G7      = ABAP_TRUE
                  WITH P_G9      = ABAP_TRUE
                  WITH P_T1      = ABAP_TRUE
                  WITH P_T2      = ABAP_TRUE
                  WITH P_T3      = ABAP_TRUE
                  WITH P_T9      = ABAP_TRUE
                  WITH P_R1      = ABAP_TRUE
                  WITH P_R2      = ABAP_TRUE
                  WITH P_R9      = ABAP_TRUE
                  AND RETURN.
ENDFORM.
 
