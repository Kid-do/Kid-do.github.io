*&---------------------------------------------------------------------*
*& Form SET_CONTAINER
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM SET_CONTAINER USING PV_GUBUN.
  CASE PV_GUBUN.
    WHEN GC_SIDE-HEAD.
      CREATE OBJECT GO_CUST_CONT
        EXPORTING
          CONTAINER_NAME = 'CON_MAIN'.
 
      CREATE OBJECT GO_SPLI_CONT
        EXPORTING
          PARENT  = GO_CUST_CONT
          ROWS    = 1
          COLUMNS = 2.
 
      GO_SPLI_CONT->SET_COLUMN_WIDTH( ID = 1 WIDTH = 65 ).
 
      GO_SPLI_CONT->SET_BORDER( BORDER = ABAP_FALSE ).
      GO_SPLI_CONT->GET_CONTAINER(: EXPORTING ROW       = 1
                                              COLUMN    = 1
                                    RECEIVING CONTAINER = GO_CONT_HEAD ),
                                    EXPORTING ROW       = 1
                                              COLUMN    = 2
                                    RECEIVING CONTAINER = GO_CONT_IT01 ).
  ENDCASE.
ENDFORM.
*&---------------------------------------------------------------------*
*& Form SET_ALV_GRID
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM SET_ALV_GRID USING LV_GUBUN.
  CASE LV_GUBUN.
    WHEN GC_SIDE-HEAD.
      IF GO_GRID_HEAD IS NOT BOUND.
        CREATE OBJECT GO_GRID_HEAD
          EXPORTING
            I_PARENT = GO_CONT_HEAD.
      ENDIF.
 
    WHEN GC_SIDE-IT01.
      IF GO_GRID_IT01 IS NOT BOUND.
        CREATE OBJECT GO_GRID_IT01
          EXPORTING
            I_PARENT = GO_CONT_IT01.
      ENDIF.
  ENDCASE.
 
ENDFORM.
*&---------------------------------------------------------------------*
*& Form SET_ALV_LAYOUT
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM SET_ALV_LAYOUT USING PV_GUBUN
                    CHANGING PS_LAYOUT TYPE LVC_S_LAYO.
  CASE PV_GUBUN.
    WHEN GC_SIDE-HEAD OR
         GC_SIDE-IT01.
      PS_LAYOUT = VALUE #( ZEBRA      = ABAP_TRUE
                           SEL_MODE   = ZCA_A
                           CWIDTH_OPT = ZCA_A
                           EDIT       = SPACE
                           SMALLTITLE = ABAP_TRUE
                           STYLEFNAME = 'CSTYL'
                           GRID_TITLE = SPACE ).
  ENDCASE.
 
ENDFORM.
