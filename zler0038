*&---------------------------------------------------------------------*
*& Form get_head
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
*& -->  p1        text
*& <--  p2        text
*&---------------------------------------------------------------------*
FORM GET_HEAD.
  DATA: LV_LFIMG_EQC(16),
        LV_LFIMG_NEC(16).
 
  DATA: BEGIN OF LS_MSKA_VALUE,
          WERKS      TYPE LIPS-WERKS,
          MATNR      TYPE LIPS-MATNR,
          ZZ_PON_LOT TYPE LIPS-ZZ_PON_LOT,
        END OF LS_MSKA_VALUE.
  DATA: LT_MSKA_VALUE LIKE TABLE OF LS_MSKA_VALUE.
 
  DATA: LS_HEAD LIKE GS_HEAD,
        LT_HEAD LIKE TABLE OF GS_HEAD.
 
  DATA: BEGIN OF LS_BUNTYPE,
          VBELN          TYPE LIPS-VBELN,
          ZZ_PON_LOT     TYPE LIPS-ZZ_PON_LOT,
          ZZ_BUNDLE_TYPE TYPE LIPS-ZZ_BUNDLE_TYPE,
          CNT            TYPE I,
        END OF LS_BUNTYPE.
  DATA LT_BUNTYPE LIKE TABLE OF LS_BUNTYPE.
 
  DATA: BEGIN OF LS_SUM,
          VBELN      TYPE LIPS-VBELN,
          ZZ_PON_LOT TYPE LIPS-ZZ_PON_LOT,
          LFIMG      TYPE LIPS-LFIMG,
          KCMENG     TYPE LIPS-KCMENG,
          ORMNG      TYPE LIPS-ORMNG,
          KALAB      TYPE MSKA-KALAB,
        END OF LS_SUM,
        LT_SUM LIKE TABLE OF LS_SUM.
 
  DATA: BEGIN OF LS_VBELN,
          ORG_VBELN  TYPE LIPS-VBELN,
          VBELN      TYPE LIPS-VBELN,
          ZZ_PON_LOT TYPE LIPS-ZZ_PON_LOT,
          MATNR      TYPE LIPS-MATNR,
        END OF LS_VBELN.
  DATA: LT_VBELN     LIKE TABLE OF LS_VBELN,
        LT_VBELN_EXT LIKE TABLE OF LS_VBELN.
 
  DATA LT_VBELN_FLOW TYPE LEDSPD_FLOW_T WITH HEADER LINE.
 
  DATA LT_LINES TYPE TABLE OF TLINE.
 
  RANGES: RA_LFART FOR LIKP-LFART,
          RA_TCODE FOR LIKP-TCODE,
          RA_EXPTY FOR LIKP-ZZ_EXPTYPE,
          RA_SPART FOR LIPS-SPART.
 
  DATA : LR_NAME1 TYPE RANGE OF KNA1-NAME1.
 
*----------------------------------------------------------------------*
  CLEAR GT_HEAD[].
  CLEAR: RA_LFART[], RA_TCODE[], RA_EXPTY[].
  MOVE-CORRESPONDING S_LFART[] TO RA_LFART[].
 
  CASE ABAP_TRUE.
    WHEN P_RAD1. "전체
      _RANGE_NP RA_LFART '*LR'. " 추가 2024.06.11
    WHEN P_RAD2. "제품
      CLEAR RA_LFART[].
      _RANGE_CP RA_LFART '*LF'.
      _RANGE_CP RA_LFART '*NL'.
    WHEN P_RAD3. "외주
      _RANGE_EQ RA_TCODE 'ZLER0092'.
      _RANGE_EQ RA_TCODE 'ZLER0095'.
    WHEN P_RAD4. "기타운송
      _RANGE_EQ RA_TCODE 'ZLER0091'.
  ENDCASE.
 
  CLEAR: RA_EXPTY[].
  CASE ABAP_TRUE.
    WHEN P_EXP1. "전체
 
    WHEN P_EXP2. "내수
      _RANGE_EQ RA_EXPTY SPACE.
    WHEN P_EXP3. "수출
      _RANGE_NE RA_EXPTY SPACE.
  ENDCASE.
*----------------------------------------------------------------------*
  CLEAR RA_SPART[].
  IF S_FEVOR[] IS NOT INITIAL.
    LOOP AT S_FEVOR INTO DATA(LS_FEVOR).
      IF LS_FEVOR-OPTION EQ 'NE'.
        IF LS_FEVOR-LOW EQ '230'.
          _RANGE_NE RA_SPART '30'.
        ENDIF.
 
        IF LS_FEVOR-LOW EQ '250'.
          _RANGE_NE RA_SPART '40'.
        ENDIF.
      ELSEIF LS_FEVOR-OPTION EQ 'EQ'.
        IF LS_FEVOR-LOW EQ '230'.
          _RANGE_EQ RA_SPART '30'.
        ENDIF.
 
        IF LS_FEVOR-LOW EQ '250'.
          _RANGE_EQ RA_SPART '40'.
        ENDIF.
      ENDIF.
    ENDLOOP.
  ENDIF.
 
  IF LINES( S_NAMAG ) > 0. "판매처명을 입력한 경우 *입력값* 로 처리.
    READ TABLE S_NAMAG INDEX 1.
    LR_NAME1[] = VALUE #( ( SIGN = ZCA_I OPTION = 'CP'
                            LOW = |*{ S_NAMAG-LOW }*| ) ).
  ENDIF.
*----------------------------------------------------------------------*
  SELECT DISTINCT A~VBELN,
                  F~POSNR,
                  A~LFART,
                  A~WADAT,
                  A~LFDAT,
                  A~KUNNR,
                  A~VSTEL,
                  A~INCO1,
                  D~NAME1,
                  D~LZONE,
                  G~VTEXT,
                  D~ORT01,
                  B~MATNR,
                  E~FEVOR,
                  B~WERKS,
                  B~LGORT,
                  B~CHARG,
                  B~VBELV,
                  B~ZZ_PON_LOT,
*                  b~zz_bundle_type,
                  F~ZZ_ORD_IRN_NAME,
                  F~ZZ_GRADETYP,
                  F~ZZ_ITEMTYPE,
                  F~ZZ_ITEMCATE,
                  F~ZZ_SHAPETYP,
                  F~ZZ_MATERIAL,
                  F~ZZ_SURFACED,
                  F~ZZ_HEATTREA,
                  F~ZZ_SECT_CLR,
                  B~VKBUR,
                  A~ZZ_REC_NAME,
                  A~ZZ_REC_TEL,
                  A~ZZ_SMNO,
                  H~BEZEI, "추가 2024.05.29
                  CASE A~ZZ_BAECHA WHEN 'D01' THEN '당사배차'
                                   WHEN 'D02' THEN '고객사배차'
                  END AS ZZ_BAECHA_TXT,
                  CASE A~ZZ_TRAILER WHEN 'A01' THEN '가능'
                                    WHEN 'A02' THEN '불가능'
                                    WHEN 'A03' THEN '무관'
                  END AS ZZ_TRAILER_TXT,
                  CASE A~ZZ_STACKING WHEN 'B01' THEN '2단'
                                     WHEN 'B02' THEN '1단'
                                     WHEN 'B03' THEN '무관'
                  END AS ZZ_STACKING_TXT,
                  CASE A~ZZ_RAIN_PACKING WHEN 'C01' THEN '필요'
                                         WHEN 'C02' THEN '불필요'
                                         WHEN 'C03' THEN '무관'
                  END AS ZZ_RAIN_PACKING_TXT,
                  CASE A~ZZ_SAT_LANDING WHEN 'D01' THEN '가능'
                                        WHEN 'D02' THEN '불가능'
                                        WHEN 'D03' THEN '사전확인요'
                  END AS ZZ_SAT_LANDING_TXT,
                  CASE A~ZZ_START_CALL WHEN 'E01' THEN '필요'
                                       WHEN 'E02' THEN '불필요'
                                       WHEN 'E03' THEN '무관'
                  END AS ZZ_START_CALL_TXT,
                  A~ZZ_DO_TEL1,
                  A~ZZ_DO_TEL2,
                  A~ZZ_DO_TEL3,
                  A~ZZ_EXPTYPE,
                  A~ZZ_SHCON,
                  A~ZZ_SHPORT,
                  A~KUNAG,
                  KNA1_AG~NAME1 AS NAME1_AG,
                  MVKE~MVGR4,
                  COALESCE( TVM4T~BEZEI,@SPACE ) AS MVGR4_NM
    INTO TABLE @DATA(LT_DATA)
    FROM LIKP AS A INNER JOIN LIPS AS B
                           ON A~VBELN EQ B~VBELN
              LEFT OUTER JOIN KNA1 AS D
                           ON A~KUNNR EQ D~KUNNR
              LEFT OUTER JOIN MARC AS E
                           ON B~WERKS EQ E~WERKS
                          AND B~MATNR EQ E~MATNR
              LEFT OUTER JOIN VBAP AS F
                           ON B~VBELV EQ F~VBELN
                          AND B~POSNV EQ F~POSNR
              LEFT OUTER JOIN TZONT AS G
                           ON D~LZONE EQ G~ZONE1
              LEFT OUTER JOIN TVSAKT AS H
                           ON H~SDABW EQ A~SDABW
                          AND H~SPRAS EQ @SY-LANGU
              LEFT OUTER JOIN KNA1 AS KNA1_AG
                           ON A~KUNAG = KNA1_AG~KUNNR
              LEFT OUTER JOIN VBPA AS VBPA
                           ON A~VBELN = VBPA~VBELN
                          AND VBPA~POSNR = '000000'
                          AND VBPA~PARVW = 'ZA'
              LEFT OUTER JOIN MVKE AS MVKE
                           ON MVKE~MATNR = B~MATNR
