*&---------------------------------------------------------------------*
FORM HOTSPOT_CLICK USING VALUE(PV_FLAG)
                         PV_ROW_ID
                         PV_COLUMN_ID.
  CASE PV_FLAG.
    WHEN GC_SIDE-HEAD.
      READ TABLE GT_HEAD ASSIGNING FIELD-SYMBOL(<LS_HEAD>) INDEX PV_ROW_ID.
      CASE PV_COLUMN_ID.
        WHEN 'ZZ_PON_LOT'.
          PERFORM GET_IT01 USING <LS_HEAD>.
      ENDCASE.
  ENDCASE.
ENDFORM.
