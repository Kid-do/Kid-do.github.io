*&---------------------------------------------------------------------*
*& Form SET_ALV_FIELDCAT
*&---------------------------------------------------------------------*
*& text
*&---------------------------------------------------------------------*
FORM SET_ALV_FIELDCAT TABLES PT_FCAT TYPE LVC_T_FCAT
                      USING  PV_GUBUN.
  DATA LO_DATA TYPE REF TO DATA.
 
  CLEAR PT_FCAT.
  REFRESH PT_FCAT[].
 
*--djs begin ~ end 25.11.13 추가
  MOVE-CORRESPONDING GT_HEAD TO GT_C_DATA.
 
  CASE PV_GUBUN.
    WHEN GC_SIDE-HEAD.
      CREATE DATA LO_DATA LIKE GT_HEAD.
    WHEN GC_SIDE-IT01.
      CREATE DATA LO_DATA LIKE GT_IT01.
  ENDCASE.
 
  ASSIGN LO_DATA->* TO FIELD-SYMBOL(<LT_DATA>).
  TRY.
      CL_SALV_TABLE=>FACTORY( IMPORTING R_SALV_TABLE = DATA(LO_SALV_TABLE)
                              CHANGING  T_TABLE      = <LT_DATA> ).
 
      DATA(LT_FCAT) = CL_SALV_CONTROLLER_METADATA=>GET_LVC_FIELDCATALOG(
        R_COLUMNS      = LO_SALV_TABLE->GET_COLUMNS( )
        R_AGGREGATIONS = LO_SALV_TABLE->GET_AGGREGATIONS( )
      ).
    CATCH CX_ROOT.
  ENDTRY.
 
  DELETE LT_FCAT WHERE FIELDNAME EQ 'MANDT'.
  PERFORM ADJUST_FLDCATS TABLES LT_FCAT PT_FCAT
                         USING  PV_GUBUN.
 
  CLEAR: LO_DATA, LO_SALV_TABLE.
  REFRESH LT_FCAT.
ENDFORM.
